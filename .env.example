# Copy to .env and fill in. docker compose reads it automatically.

# ---- Database ----
POSTGRES_PASSWORD=delegation
# Load fictional engineers and projects on an empty database (turn off once real data is in)
SEED_DEMO=true
# Set to true for managed Postgres that requires TLS (e.g. IBM Cloud Databases for PostgreSQL)
# DB_SSL=true

# ---- Sign-in ----
# dev   = a "Viewing as" switch in the UI picks the user. Local use only.
# proxy = trust the email header set by your SSO proxy (IBM App ID, oauth2-proxy, ...)
AUTH_MODE=dev
# AUTH_HEADER=x-forwarded-email

# ---- Monday board ----
# Personal API token: avatar menu -> Developers -> My access tokens (member account, not a viewer)
MONDAY_API_TOKEN=
# The number after /boards/ in the board URL
MONDAY_BOARD_ID=
# Optional: pin the API version, e.g. 2025-04
# MONDAY_API_VERSION=
# Full re-sync interval in minutes (webhooks handle changes in between). 0 turns it off.
MONDAY_SYNC_MINUTES=15
# Random string; it's added to the webhook URL so only Monday can post to it
MONDAY_WEBHOOK_SECRET=

# Column IDs on your board. Find them on the dashboard's Monday board page ("Look up board column IDs").
MONDAY_COL_CLIENT=client
MONDAY_COL_PRODUCT_TYPE=product_type
MONDAY_COL_STATUS=status
MONDAY_COL_PEOPLE=people
MONDAY_COL_TIMELINE=timeline
# Optional numbers column for the kickoff seat cap
MONDAY_COL_SEAT_CAP=

# Status labels on the board, comma-separated. Anything not listed counts as a new project.
MONDAY_STATUS_PROGRESS=Working on it,In progress
MONDAY_STATUS_HOLD=On hold,Stuck
MONDAY_STATUS_DONE=Done,Closed

# ---- Slack ----
# Incoming webhook for placement notices. Leave empty to log notices instead.
SLACK_WEBHOOK_URL=
